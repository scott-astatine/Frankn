<?xml version="1.0" encoding="utf-8"?>
<!-- Frankn Splash Screen — Cyberpunk void black with neon accent (API 21+) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">

    <!-- Void black background -->
    <item android:drawable="@color/void_black" />

    <!-- Subtle corner brackets (HID framing) -->
    <item android:top="48dp" android:left="48dp" android:width="24dp" android:height="24dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#1A1A2E" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:top="48dp" android:right="48dp" android:width="24dp" android:height="24dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#1A1A2E" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:bottom="48dp" android:left="48dp" android:width="24dp" android:height="24dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#1A1A2E" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:bottom="48dp" android:right="48dp" android:width="24dp" android:height="24dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#1A1A2E" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Loading bar at bottom -->
    <item android:bottom="80dp" android:left="96dp" android:right="96dp" android:height="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00F3FF"
                android:endColor="#00FF41"
                android:angle="0" />
            <corners android:radius="1dp" />
        </shape>
    </item>

</layer-list>
