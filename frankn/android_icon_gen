#!/usr/bin/env bash
# ============================================================================
# Franken Icon Factory v2 — SVG → Adaptive Icons + Launcher + Play Store
# ============================================================================
# Usage: cd frankn && bash android_icon_gen
#
# Requires:
#   - librsvg  (rsvg-convert)   — SVG → PNG
#   - ImageMagick 7 (magick)    — resize / crop / composite
# ============================================================================
set -euo pipefail

SVG_ICON="android/app/src/main/res/logo.svg"
SVG_FG="android/app/src/main/res/logo-foreground.svg"
RES_DIR="android/app/src/main/res"

# Density buckets: name → standard icon size (px)
declare -A SIZES=(
    ["mipmap-mdpi"]=48
    ["mipmap-hdpi"]=72
    ["mipmap-xhdpi"]=96
    ["mipmap-xxhdpi"]=144
    ["mipmap-xxxhdpi"]=192
)

BG_COLOR="#050505"

# ── Dependency check ──
for cmd in rsvg-convert magick; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "❌ Missing: $cmd"
    echo "   Install:  sudo pacman -S librsvg imagemagick"
    exit 1
  fi
done

if [ ! -f "$SVG_ICON" ]; then
  echo "❌ Not found: $SVG_ICON"
  exit 1
fi

echo "⚡ Franken Icon Factory v2"
echo "   Source : $SVG_ICON"
echo ""

# ── Convert SVGs to master PNGs ──
MASTER="$RES_DIR/.icon-master.png"
FG_MASTER="$RES_DIR/.icon-fg-master.png"

echo "🎨 Rendering SVGs → PNG (1024×1024)..."
rsvg-convert --width=1024 --height=1024 -o "$MASTER" "$SVG_ICON"
if [ -f "$SVG_FG" ]; then
  rsvg-convert --width=1024 --height=1024 -o "$FG_MASTER" "$SVG_FG"
else
  echo "   ⚠ No foreground SVG found — adaptive foregrounds will be skipped."
  FG_MASTER=""
fi

# ── Generate per-density assets ──
for folder in "${!SIZES[@]}"; do
  size=${SIZES[$folder]}
  dir="$RES_DIR/$folder"
  mkdir -p "$dir"

  # Standard launcher icon (full icon with background)
  magick "$MASTER" -resize "${size}x${size}^" -gravity center \
    -extent "${size}x${size}" "$dir/ic_launcher.png"

  # Round variant
  cp "$dir/ic_launcher.png" "$dir/ic_launcher_round.png"

  # Adaptive icon layers (108dp = size × 1.5)
  if [ -n "$FG_MASTER" ]; then
    fg_size=$(( size * 3 / 2 ))

    # Foreground (transparent, centred)
    magick "$FG_MASTER" -resize "${fg_size}x${fg_size}^" -gravity center \
      -extent "${fg_size}x${fg_size}" "$dir/ic_launcher_foreground.png"

    # Background (solid void black)
    magick -size "${fg_size}x${fg_size}" xc:"$BG_COLOR" \
      "$dir/ic_launcher_background.png"
  fi

  echo "   ✓ $folder (${size}px)"
done

# ── Play Store icon (512×512) ──
magick "$MASTER" -resize 512x512! "$RES_DIR/ic_launcher-playstore.png"
echo "   ✓ Play Store (512px)"

# ── Cleanup ──
rm -f "$MASTER" "$FG_MASTER"

echo ""
echo "✅ All assets forged. Franken is ready to mobile."
